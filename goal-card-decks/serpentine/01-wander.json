  "title": "Serpentine 1 / source controls and wander",
  "goal": "Explore serpiginous, cohesive boid trails: a connected winding ribbon with alternating bends. These accumulated stills test visible trail structure, not sustained moving-group cohesion, speed, or leader following.",
  "successCriteria": [
    "Most visible paint forms one elongated connected ribbon with successive alternating bends.",
    "The main trail remains visually continuous and narrower than a dispersed cloud.",
    "Small white gaps remain visible without breaking the main band into separate clusters.",
    "Rate only visible accumulated-image properties; use N/A and notes for ambiguity, clipping, or motion that cannot be inferred."
  ],
  "sharedQuestions": [
    {
      "id": "ribbon",
      "text": "Most visible paint belongs to one connected, elongated ribbon rather than separate clusters."
    },
    {
      "id": "bends",
      "text": "The visible ribbon has successive bends in alternating directions."
    },
    {
      "id": "continuity",
      "text": "The main painted trail has no visible breaks along its length."
    },
    {
      "id": "compactness",
      "text": "Visible marks occupy a compact band rather than a broad scattered cloud."
    },
    {
      "id": "gaps",
      "text": "White gaps remain visible between marks inside the painted band."
    }
  ],
