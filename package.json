{
  "name": "boid-brush",
  "version": "0.1.0",
  "private": true,
  "description": "Boid Brush shared web app with a thin Electron desktop shell",
  "main": "electron/main.cjs",
  "scripts": {
    "setup": "npm install",
    "start:web": "node electron/start-web.cjs",
    "start:desktop": "node electron/start-desktop.cjs",
    "build:desktop": "electron-builder --dir",
    "package:desktop": "electron-builder"
  },
  "devDependencies": {
    "electron": "^42.3.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.gigigugit.boidbrush",
    "productName": "Boid Brush",
    "files": [
      "electron/**/*",
      "*.html",
      "*.js",
      "*.png",
      "wasm-sim/pkg/**/*",
      "README.md",
      "docs/third-party-licenses.md"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "mac": {
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Graphics"
    },
    "win": {
      "target": [
        "nsis",
        "dir"
      ]
    }
  }
}
